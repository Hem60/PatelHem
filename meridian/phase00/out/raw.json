        "pyproject.toml": "[project]\nname = \"vakil\"\nversion = \"0.1.0\"\ndescription = \"Autonomous chargeback defence agent for Razorpay merchants\"\nrequires-python = \">=3.12\"\ndependencies = [\n    \"pydantic>=2.9\",\n    \"pydantic-settings>=2.6\",\n    \"fastapi>=0.115\",\n    # FastAPI needs this to accept multipart uploads. The Documents API\n    # takes files, so the mock cannot even be imported without it - which\n    # went unnoticed until a test imported the mock for the first time.\n    \"python-multipart>=0.0.9\",\n    \"uvicorn[standard]>=0.32\",\n    \"httpx>=0.27\",\n    \"anthropic>=0.40\",\n    \"langgraph>=0.2.45\",\n    \"langgraph-checkpoint-postgres>=2.0\",\n    \"psycopg[binary,pool]>=3.2\",\n    \"pgvector>=0.3\",\n    \"structlog>=24.4\",\n    \"typer>=0.15\",\n    \"rich>=13.9\",\n]\n\n[project.optional-dependencies]\ndev = [\n    # Renders the proof-of-delivery fixtures. A dev dependency rather than a\n    # runtime one: the generator builds test data, it is not part of serving a\n    # dispute. CI installs .[dev] and runs `make fixtures`, which is how the\n    # missing declaration was found - it was pip-installed by hand locally and\n    # never written down, so every fresh clone would have failed.\n    \"pillow>=11.0\",\n    \"pytest>=8.3\",\n    \"pytest-cov>=6.0\",\n    \"ruff>=0.8\",\n    \"mypy>=1.13\",\n]\n\n[project.scripts]\nvakil = \"vakil.cli:app\"\n\n[build-system]\nrequires = [\"hatchling\"]\nbuild-backend = \"hatchling.build\"\n\n[tool.hatch.build.targets.wheel]\npackages = [\"src/vakil\"]\n\n[tool.pytest.ini_options]\npythonpath = [\"src\"]\ntestpaths = [\"tests\"]\naddopts = \"-q\"\n\n[tool.ruff]\nline-length = 100\ntarget-version = \"py312\"\n\n[tool.ruff.lint]\nselect = [\"E\", \"F\", \"I\", \"UP\", \"B\", \"SIM\"]\n\n[tool.ruff.lint.per-file-ignores]\n# Typer declares CLI parameters as call expressions in defaults. That is the\n# framework's required idiom, not the mutable-default bug B008 looks for.\n\"src/vakil/cli.py\" = [\"B008\"]\n\n[tool.mypy]\npython_version = \"3.12\"\nstrict = true\nfiles = [\"src/vakil\"]\n"
      },
