[{"sha":"eccd8c45b2a645a3777e96ec243e428b617b1fc6","node_id":"C_kwDOTRv_8NoAKGVjY2Q4YzQ1YjJhNjQ1YTM3NzdlOTZlYzI0M2U0MjhiNjE3YjFmYzY","commit":{"author":{"name":"Hem Patel","email":"patelhem60@gmail.com","date":"2026-08-09T07:32:13Z"},"committer":{"name":"Hem Patel","email":"patelhem60@gmail.com","date":"2026-08-09T07:32:27Z"},"message":"Fix PUA glyph leakage in ingestion and eval report accounting\n\nIngestion: PDFs using Symbol/Wingdings for bullets encode them in the\nUnicode Private Use Area (U+E000-U+F8FF). pypdf passed those codepoints\nthrough verbatim, so glyphs like U+F0B7 were embedded into FAISS and fed\nto the LLM as context. Add clean_text(): map known Symbol/Wingdings\nbullets to ASCII, strip remaining PUA, NFKC-normalise (folds ligatures\nso retrieval matches typed words), and collapse layout whitespace.\nRebuilding the index drops 295 PUA chars to 0.\n\nAlso drop the ascii/replace coercion in the sample-chunk preview, which\nwas hiding these glyphs behind \"?\" during the sanity check.\n\nEvaluation: scores.append() ran only on the success path, while the\nexcept branch recorded score 0 without touching scores. The average was\ntherefore computed over scored questions only (21/6 = 3.5) and printed\ndirectly under \"Questions evaluated: 10\". Record errored questions as\nnull rather than 0, track attempted/scored/errored counts so the report\nreconciles, and report both average_score (scored only) and\naverage_score_penalised (errors counted as 1). Flag scores recovered by\nthe regex fallback, which were previously indistinguishable from clean\njudge output.\n\nThe committed report is re-derived from its own per-question data: 10\nattempted, 6 scored, 4 errored on HTTP 402 (free-tier credits exhausted\nat Q7). Note Q10, the refusal test, never ran.\n\nCo-Authored-By: Claude Opus 5 <noreply@anthropic.com>","tree":{"sha":"baf6d96f18f9acb099eb940c96ffab51c29a699f","url":"https://api.github.com/repos/Hem60/RAG-CHAT-BOT/git/trees/baf6d96f18f9acb099eb940c96ffab51c29a699f"},"url":"https://api.github.com/repos/Hem60/RAG-CHAT-BOT/git/commits/eccd8c45b2a645a3777e96ec243e428b617b1fc6","comment_count":0,"verification":{"verified":false,"reason":"unsigned","signature":null,"payload":null,"verified_at":null}},"url":"https://api.github.com/repos/Hem60/RAG-CHAT-BOT/commits/eccd8c45b2a645a3777e96ec243e428b617b1fc6","html_url":"https://github.com/Hem60/RAG-CHAT-BOT/commit/eccd8c45b2a645a3777e96ec243e428b617b1fc6","comments_url":"https://api.github.com/repos/Hem60/RAG-CHAT-BOT/commits/eccd8c45b2a645a3777e96ec243e428b617b1fc6/comments","author":{"login":"Hem60","id":227198061,"node_id":"U_kgDODYrEbQ","avatar_url":"https://avatars.githubusercontent.com/u/227198061?v=4","gravatar_id":"","url":"https://api.github.com/users/Hem60","html_url":"https://github.com/Hem60","followers_url":"https://api.github.com/users/Hem60/followers","following_url":"https://api.github.com/users/Hem60/following{/other_user}","gists_url":"https://api.github.com/users/Hem60/gists{/gist_id}","starred_url":"https://api.github.com/users/Hem60/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/Hem60/subscriptions","organizations_url":"https://api.github.com/users/Hem60/orgs","repos_url":"https://api.github.com/users/Hem60/repos","events_url":"https://api.github.com/users/Hem60/events{/privacy}","received_events_url":"https://api.github.com/users/Hem60/received_events","type":"User","user_view_type":"public","site_admin":false},"committer":{"login":"Hem60","id":227198061,"node_id":"U_kgDODYrEbQ","avatar_url":"https://avatars.githubusercontent.com/u/227198061?v=4","gravatar_id":"","url":"https://api.github.com/users/Hem60","html_url":"https://github.com/Hem60","followers_url":"https://api.github.com/users/Hem60/followers","following_url":"https://api.github.com/users/Hem60/following{/other_user}","gists_url":"https://api.github.com/users/Hem60/gists{/gist_id}","starred_url":"https://api.github.com/users/Hem60/starred{/owner}{/repo}","subscrip