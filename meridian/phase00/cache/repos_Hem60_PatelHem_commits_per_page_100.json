d1081029b31828df8629f8e54f9fb6f7cf1c2a6","node_id":"C_kwDOUN_fV9oAKGNkMTA4MTAyOWIzMTgyOGRmODYyOWY4ZTU0ZjlmYjZmN2NmMWMyYTY","commit":{"author":{"name":"Hem Patel","email":"patelhem60@gmail.com","date":"2026-09-04T08:40:38Z"},"committer":{"name":"Hem Patel","email":"patelhem60@gmail.com","date":"2026-09-04T08:40:38Z"},"message":"Declare the framework at the repository root\n\nThe deploy failed with \"No Next.js version detected\". Vercel reads the\nframework from the package.json at the Root Directory, and the root had no\npackage.json at all — so it gave up before reaching a build.\n\nThe root has to be the root directory here: meridian/site depends on\n../engine and ../pipeline through file: links and cannot build without its\nsiblings present. Pointing Vercel at meridian/site instead would fix the\ndetection and break the resolution.\n\nSo the framework is declared at the root, pinned to the version the site\nactually uses. Nothing installs from this manifest — each package installs\nits own dependencies, and vercel.json's installCommand does the same on the\nbuilder.\n\nCo-Authored-By: Claude Opus 5 <noreply@anthropic.com>","tree":{"sha":"baad728ee53cec97369f9c4daf41e1c183dbb3ed","url":"https://api.github.com/repos/Hem60/PatelHem/git/trees/baad728ee53cec97369f9c4daf41e1c183dbb3ed"},"url":"https://api.github.com/repos/Hem60/PatelHem/git/commits/cd1081029b31828df8629f8e54f9fb6f7cf1c2a6","comment_count":0,"verification":{"verified":false,"reason":"unsigned","signature":null,"payload":null,"verified_at":null}},"url":"https://api.github.com/repos/Hem60/PatelHem/commits/cd1081029b31828df8629f8e54f9fb6f7cf1c2a6","html_url":"https://github.com/Hem60/PatelHem/commit/cd1081029b31828df8629f8e54f9fb6f7cf1c2a6","comments_url":"https://api.github.com/repos/Hem60/PatelHem/commits/cd1081029b31828df8629f8e54f9fb6f7cf1c2a6/comments","author":{"login":"Hem60","id":227198061,"node_id":"U_kgDODYrEbQ","avatar_url":"https://avatars.githubusercontent.com/u/227198061?v=4","gravatar_id":"","url":"https://api.github.com/users/Hem60","html_url":"https://github.com/Hem60","followers_url":"https://api.github.com/users/Hem60/followers","following_url":"https://api.github.com/users/Hem60/following{/other_user}","gists_url":"https://api.github.com/users/Hem60/gists{/gist_id}","starred_url":"https://api.github.com/users/Hem60/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/Hem60/subscriptions","organizations_url":"https://api.github.com/users/Hem60/orgs","repos_url":"https://api.github.com/users/Hem60/repos","events_url":"https://api.github.com/users/Hem60/events{/privacy}","received_events_url":"https://api.github.com/users/Hem60/received_events","type":"User","user_view_type":"public","site_admin":false},"committer":{"login":"Hem60","id":227198061,"node_id":"U_kgDODYrEbQ","avatar_url":"https://avatars.githubusercontent.com/u/227198061?v=4","gravatar_id":"","url":"https://api.github.com/users/Hem60","html_url":"https://github.com/Hem60","followers_url":"https://api.github.com/users/Hem60/followers","following_url":"https://api.github.com/users/Hem60/following{/other_user}","gists_url":"https://api.github.com/users/Hem60/gists{/gist_id}","starred_url":"https://api.github.com/users/Hem60/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/Hem60/subscriptions","organizations_url":"https://api.github.com/users/Hem60/orgs","repos_url":"https://api.github.com/users/Hem60/repos","events_url":"https://api.github.com/users/Hem60/events{/privacy}","received_events_url":"https://api.github.com/users/Hem60/received_events","type":"User","user_view_type":"public","site_admin":false},"parents":[{"sha":"be304456bd6255dc2ecb4697597af56b655c42ee","url":"https://api.github.com/repos/Hem60/PatelHem/commits/be304456bd6255dc2ecb4697597af56b655c42ee","html_url":"https://github.com/Hem60/PatelHem/commit/be304456bd6255dc2ecb4697597af56b655c42ee"}]},{"sha":"be304456bd6255dc2ecb4697597af56b655c42ee","node_id":"C_kwDOUN_fV9oAKGJlMzA0NDU2YmQ2MjU1ZGMyZWNiNDY5NzU5N2FmNTZiNjU1YzQyZWU","commit":{"author":{"name":"Hem Patel","email":"patelhem60@gmail.com","date":"2026-09-04T08:27:24Z"},"committer":{"name":"Hem Patel","email":"patelhem60@gmail.com","date":"2026-09-04T08:27:24Z"},"message":"Add .vercelignore, and ignore .vercel\n\nThe CLI falls back to .gitignore when .vercelignore is absent, which is fine\nuntil somebody adds one for an unrelated reason and the fallback silently\nstops applying — at which point the upload is ~1GB of node_modules and 62MB\nof reference frames. Being explicit costs nothing and removes that trapdoor.\nIt also excludes .env and .env.local, so no token can ride along.\n\n.vercel is the CLI's own project link and is not shareable.\n\nCo-Authored-By: Claude Opus 5 <noreply@anthropic.com>","tree":{"sha":"20bc6ae4a1989a564773c9b79ab74eeda2ada847","url":"https://api.github.com/repos/Hem60/PatelHem/git/trees/20bc6ae4a1989a564773c9b79ab74eeda2ada847"},"url":"https://api.github.com/repos/Hem60/PatelHem/git/commits/be304456bd6255dc2ecb4697597af56b655c42ee","comment_count":0,"verification":{"verified":false,"reason":"unsigned","signature":null,"payload":null,"verified_at":null}},"url":"https://api.github.com/repos/Hem60/PatelHem/commits/be304456bd6255dc2ecb4697597af56b655c42ee","html_url":"https://github.com/Hem60/PatelHem/commit/be304456bd6255dc2ecb4697597af56b655c42ee","comments_url":"https://api.github.com/repos/Hem60/PatelHem/commits/be304456bd6255dc2ecb4697597af56b655c42ee/comments","author":{"login":"Hem60","id":227198061,"node_id":"U_kgDODYrEbQ","avatar_url":"https://avatars.githubusercontent.com/u/227198061?v=4","gravatar_id":"","url":"https://api.github.com/users/Hem60","html_url":"https://github.com/Hem60","followers_url":"https://api.github.com/users/Hem60/followers","following_url":"https://api.github.com/users/Hem60/following{/other_user}","gists_url":"https://api.github.com/users/Hem60/gists{/gist_id}","starred_url":"https://api.github.com/users/Hem60/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/Hem60/subscriptions","organizations_url":"https://api.github.com/users/Hem60/orgs","repos_url":"https://api.github.com/users/Hem60/repos","events_url":"https://api.github.com/users/Hem60/events{/privacy}","received_events_url":"https://api.github.com/users/Hem60/received_events","type":"User","user_view_type":"public","site_admin":false},"committer":{"login":"Hem60","id":227198061,"node_id":"U_kgDODYrEbQ","avatar_url":"https://avatars.githubusercontent.com/u/227198061?v=4","gravatar_id":"","url":"https://api.github.com/users/Hem60","html_url":"https://github.com/Hem60","followers_url":"https://api.github.com/users/Hem60/followers","following_url":"https://api.github.com/users/Hem60/following{/other_user}","gists_url":"https://api.github.com/users/Hem60/gists{/gist_id}","starred_url":"https://api.github.com/users/Hem60/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/Hem60/subscriptions","organizations_url":"https://api.github.com/users/Hem60/orgs","repos_url":"https://api.github.com/users/Hem60/repos","events_url":"https://api.github.com/users/Hem60/events{/privacy}","received_events_url":"https://api.github.com/users/Hem60/received_events","type":"User","user_view_type":"public","site_admin":false},"parents":[{"sha":"189c196101e7601d8edbbc05fc360c947675a37c","url":"https://api.github.com/repos/Hem60/PatelHem/commits/189c196101e7601d8edbbc05fc360c947675a37c","html_url":"https://github.com/Hem60/PatelHem/commit/189c196101e7601d8edbbc05fc360c947675a37c"}]},{"sha":"189c196101e7601d8edbbc05fc360c947675a37c","node_id":"C_kwDOUN_fV9oAKDE4OWMxOTYxMDFlNzYwMWQ4ZWRiYmMwNWZjMzYwYzk0NzY3NWEzN2M","commit":{"author":{"name":"Hem Patel","email":"patelhem60@gmail.com","date":"2026-09-04T08:27:24Z"},"committer":{"name":"Hem Patel","email":"patelhem60@gmail.com","date":"2026-09-04T08:27:24Z"},"message":"Make the repository deployable to Vercel\n\nThe site is not standalone: it imports `@meridian/pipeline/dist/herald.js`,\nand `dist/` is gitignored — so on a fresh clone that file does not exist and\nthe build fails at the import. It also resolves `@meridian/engine` through a\n`file:../engine` dependency, so it cannot be built from `meridian/site` alone.\n\nvercel.json therefore runs from the repository root and builds the engine and\nthe pipeline before the site, in that order. Verified from a clean state with\nboth dist directories deleted.\n\nDEPLOY.md records why, so the next person does not set Root Directory to\nmeridian/site and spend an afternoon on it.\n\nCo-Authored-By: Claude Opus 5 <noreply@anthropic.com>","tree":{"sha":"4587dca7af5936e38209487a05ae95768d0d444b","url":"https://api.github.com/repos/Hem60/PatelHem/git/trees/4587dca7af5936e38209487a05ae95768d0d444b"},"url":"https://api.github.com/repos/Hem60/PatelHem/git/commits/189c196101e7601d8edbbc05fc360c947675a37c","comment_count":0,"verification":{"verified":false,"reason":"unsigned","signature":null,"payload":null,"verified_at":null}},"url":"https://api.github.com/repos/Hem60/PatelHem/commits/189c196101e7601d8edbbc05fc360c947675a37c","html_url":"https://github.com/Hem60/PatelHem/commit/189c196101e7601d8edbbc05fc360c947675a37c","comments_url":"https://api.github.com/repos/Hem60/PatelHem/commits/189c196101e7601d8edbbc05fc360c947675a37c/comments","author":{"login":"Hem60","id":227198061,"node_id":"U_kgDODYrEbQ","avatar_url":"https://avatars.githubusercontent.com/u/227198061?v=4","gravatar_id":"","url":"https://api.github.com/users/Hem60","html_url":"https://github.com/Hem60","followers_url":"https://api.github.com/users/Hem60/followers","following_url":"https://api.github.com/users/Hem60/following{/other_user}","gists_url":"https://api.github.com/users/Hem60/gists{/gist_id}","starred_url":"https://api.github.com/users/Hem60/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/Hem60/subscriptions","organizations_url":"https://api.github.com/users/Hem60/orgs","repos_url":"https://api.github.com/users/Hem60/repos","events_url":"https://api.github.com/users/Hem60/events{/privacy}","received_events_url":"https://api.github.com/users/Hem60/received_events","type":"User","user_view_type":"public","site_admin":false},"committer":{"login":"Hem60","id":227198061,"node_id":"U_kgDODYrEbQ","avatar_url":"https://avatars.githubusercontent.com/u/227198061?v=4","gravatar_id":"","url":"https://api.github.com/users/Hem60","html_url":"https://github.com/Hem60","followers_url":"https://api.github.com/users/Hem60/followers","following_url":"https://api.github.com/users/Hem60/following{/other_user}","gists_url":"https://api.github.com/users/Hem60/gists{/gist_id}","starred_url":"https://api.github.com/users/Hem60/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/Hem60/subscriptions","organizations_url":"https://api.github.com/users/Hem60/orgs","repos_url":"https://api.github.com/users/Hem60/repos","events_url":"https://api.github.com/users/Hem60/events{/privacy}","received_events_url":"https://api.github.com/users/Hem60/received_events","type":"User","user_view_type":"public","site_admin":false},"parents":[{"sha":"bca2658ec38e27825cee747970023ca7866db80d","url":"https://api.github.com/repos/Hem60/PatelHem/commits/bca2658ec38e27825cee747970023ca7866db80d","html_url":"https://github.com/Hem60/PatelHem/commit/bca2658ec38e27825cee747970023ca7866db80d"}]},{"sha":"bca2658ec38e27825cee747970023ca7866db80d","node_id":"C_kwDOUN_fV9oAKGJjYTI2NThlYzM4ZTI3ODI1Y2VlNzQ3OTcwMDIzY2E3ODY2ZGI4MGQ","commit":{"author":{"name":"Hem Patel","email":"patelhem60@gmail.com","date":"2026-09-04T08:27:23Z"},"committer":{"name":"Hem Patel","email":"patelhem60@gmail.com","date":"2026-09-04T08:27:23Z"},"message":"Meridian: a self-classifying engineering portfolio\n\nInstruments read the owner's repositories, score them on five fixed axes,\npublish a catalogue, and revise it when the readings change. Nothing is\nself-reported: every rank is computed and every published clause is verified\nagainst a path that resolves before it ships.\n\n  engine    pure scoring, no I/O and no clock, so a rank is reproducible\n  pipeline  survey, compose, verify, diff, publish\n  site      the catalogue rendered, plus a live observing run over SSE\n\nThere is no language model anywhere in it. Prose comes from templates bound\nto measured signals, and a template only fires when its evidence is present.\n\nCo-Authored-By: Claude Opus 5 <noreply@anthropic.com>","tree":{"sha":"64e01f1ab248e7522c7674788a2ab19fc997cf7d","url":"https://api.github.com/repos/Hem60/PatelHem/git/trees/64e01f1ab248e7522c7674788a2ab19fc997cf7d"},"url":"https://api.github.com/repos/Hem60/PatelHem/git/commits/bca2658ec38e27825cee747970023ca7866db80d","comment_count":0,"verification":{"verified":false,"reason":"unsigned","signature":null,"payload":null,"verified_at":null}},"url":"https://api.github.com/repos/Hem60/PatelHem/commits/bca2658ec38e27825cee747970023ca7866db80d","html_url":"https://github.com/Hem60/PatelHem/commit/bca2658ec38e27825cee747970023ca7866db80d","comments_url":"https://api.github.com/repos/Hem60/PatelHem/commits/bca2658ec38e27825cee747970023ca7866db80d/comments","author":{"login":"Hem60","id":227198061,"node_id":"U_kgDODYrEbQ","avatar_url":"https://avatars.githubusercontent.com/u/227198061?v=4","gravatar_id":"","url":"https://api.github.com/users/Hem60","html_url":"https://github.com/Hem60","followers_url":"https://api.github.com/users/Hem60/followers","following_url":"https://api.github.com/users/Hem60/following{/other_user}","gists_url":"https://api.github.com/users/Hem60/gists{/gist_id}","starred_url":"https://api.github.com/users/Hem60/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/Hem60/subscriptions","organizations_url":"https://api.github.com/users/Hem60/orgs","repos_url":"https://api.github.com/users/Hem60/repos","events_url":"https://api.github.com/users/Hem60/events{/privacy}","received_events_url":"https://api.github.com/users/Hem60/received_events","type":"User","user_view_type":"public","site_admin":false},"committer":{"login":"Hem60","id":227198061,"node_id":"U_kgDODYrEbQ","avatar_url":"https://avatars.githubusercontent.com/u/227198061?v=4","gravatar_id":"","url":"https://api.github.com/users/Hem60","html_url":"https://github.com/Hem60","followers_url":"https://api.github.com/users/Hem60/followers","following_url":"https://api.github.com/users/Hem60/following{/other_user}","gists_url":"https://api.github.com/users/Hem60/gists{/gist_id}","starred_url":"https://api.github.com/users/Hem60/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/Hem60/subscriptions","organizations_url":"https://api.github.com/users/Hem60/orgs","repos_url":"https://api.github.com/users/Hem60/repos","events_url":"https://api.github.com/users/Hem60/events{/privacy}","received_events_url":"https://api.github.com/users/Hem60/received_events","type":"User","user_view_type":"public","site_admin":false},"parents":[]}]